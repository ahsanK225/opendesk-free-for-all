#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../../assets/brand/opendesk-native.ico"
1 VERSIONINFO
FILEVERSION @OPENDESK_WINDOWS_VERSION@
PRODUCTVERSION @OPENDESK_WINDOWS_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "OpenDesk Project\0"
      VALUE "FileDescription", "OpenDesk Native Remote Desktop\0"
      VALUE "FileVersion", "@OPENDESK_VERSION@\0"
      VALUE "ProductName", "OpenDesk\0"
      VALUE "ProductVersion", "@OPENDESK_VERSION@\0"
      VALUE "OriginalFilename", "OpenDesk.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
