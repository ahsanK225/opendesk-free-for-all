# -*- mode: python ; coding: utf-8 -*-
from PyInstaller.utils.hooks import collect_data_files

block_cipher = None

sounddevice_datas = collect_data_files('_sounddevice_data')

a = Analysis(
    ['opendesk_app.py'],
    pathex=['.'],
    binaries=[],
    datas=[
        ('web', 'web'),
        ('web', 'opendesk/web'),
        ('bin', 'bin'),
        ('bin', 'opendesk/bin'),
    ] + sounddevice_datas,
    hiddenimports=[
        'aiohttp',
        'websockets',
        'PIL',
        'PIL.Image',
        'PIL.ImageDraw',
        'PIL.ImageTk',
        'mss',
        'mss.windows',
        'sounddevice',
        'numpy',
        '_sounddevice_data',
        'tkinter',
        'tkinter.ttk',
        'tkinter.messagebox',
        'tkinter.simpledialog',
        'client',
        'client.viewer',
        'common',
        'common.config',
        'common.protocol',
        'common.tunnel',
        'host',
        'host.agent',
        'host.audio',
        'host.capture',
        'host.clipboard',
        'host.input_handler',
        'relay',
        'relay.server',
        'opendesk.client',
        'opendesk.client.viewer',
        'opendesk.common',
        'opendesk.common.config',
        'opendesk.common.protocol',
        'opendesk.common.tunnel',
        'opendesk.host',
        'opendesk.host.agent',
        'opendesk.host.audio',
        'opendesk.host.capture',
        'opendesk.host.clipboard',
        'opendesk.host.input_handler',
        'opendesk.relay',
        'opendesk.relay.server',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name='OpenDesk',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,  # Windowed GUI application like AnyDesk
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon='opendesk.ico',
)
